MYSQL_DATABASE=smartsplit
MYSQL_USER=smartsplit
MYSQL_PASSWORD=smartsplit_dev
MYSQL_ROOT_PASSWORD=root_dev
JWT_SECRET=replace-this-with-at-least-32-characters-before-production

OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_STORAGE_DIRECTORY=./uploads/receipts
TESSERACT_LANGUAGE=vie+eng
TESSERACT_PSM=6
TESSERACT_MULTI_PASS=true
TESSERACT_TIMEOUT_SECONDS=40
TESSERACT_PREPROCESS=true
TESSERACT_TARGET_WIDTH=1800

# Chỉ cần khi tesseract chưa nằm trong PATH hoặc tessdata ở vị trí riêng:
# TESSERACT_EXECUTABLE=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSERACT_DATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
